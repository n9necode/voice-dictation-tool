{
  "manifest_version": 3,
  "name": "Voice Chat",
  "version": "1.2.0",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Voice Chat"
  }
}
